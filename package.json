{
  "name": "discord_instants_player_ui",
  "version": "0.1.0",
  "author": "pinheirolucas",
  "main": "build/electron.js",
  "homepage": "./",
  "build": {
    "publish": {
      "provider": "github"
    },
    "files": [
      "build/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "build/electron.js"
    }
  },
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/archivo": "^5.2.5",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "axios": "^1.20.0",
    "bonjour-service": "1.4.4",
    "ramda": "^0.32.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^20.1.1",
    "update-electron-app": "^3.3.0"
  },
  "scripts": {
    "react-start": "vite",
    "react-build": "vite build",
    "react-test": "vitest",
    "typecheck": "tsc --noEmit",
    "electron-compile": "tsup",
    "electron-watch": "tsup --watch",
    "electron-build": "electron-builder",
    "release": "pnpm react-build && pnpm electron-compile && electron-builder --publish=always",
    "build": "pnpm react-build && pnpm electron-compile && pnpm electron-build",
    "start": "concurrently \"pnpm react-start\" \"pnpm electron-watch\" \"wait-on http://localhost:3000 build/electron.js && electron .\"",
    "storybook": "storybook dev -p 6006 --no-open"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.7.0",
    "@types/ramda": "^0.32.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1",
    "msw": "2.15.0",
    "storybook": "^10.6.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wait-on": "^9.1.0"
  }
}
