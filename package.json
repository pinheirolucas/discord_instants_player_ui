{
  "name": "discord_instants_player_ui",
  "version": "0.1.0",
  "author": "pinheirolucas",
  "main": "public/electron.js",
  "homepage": "./",
  "build": {
    "publish": {
      "provider": "github"
    },
    "files": [
      "build/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "build/electron.js"
    }
  },
  "private": true,
  "dependencies": {
    "@material-ui/core": "^4.12.4",
    "@material-ui/icons": "^4.11.3",
    "@testing-library/jest-dom": "^4.2.4",
    "@testing-library/react": "^9.3.2",
    "@testing-library/user-event": "^7.1.2",
    "axios": "^1.20.0",
    "electron-is-dev": "^1.1.0",
    "prop-types": "^15.8.1",
    "ramda": "^0.32.0",
    "react": "^16.13.1",
    "react-dom": "^16.13.1",
    "react-dropzone": "^20.1.1",
    "update-electron-app": "^1.5.0",
    "use-persisted-state": "^0.3.3"
  },
  "scripts": {
    "react-start": "vite",
    "react-build": "vite build",
    "react-test": "vitest",
    "electron-build": "electron-builder",
    "release": "pnpm react-build && electron-builder --publish=always",
    "build": "pnpm react-build && pnpm electron-build",
    "start": "concurrently \"pnpm react-start\" \"wait-on http://localhost:3000 && electron .\""
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^8.1.1",
    "electron-builder": "^22.4.1",
    "jsdom": "^30.0.1",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wait-on": "^9.1.0"
  }
}
