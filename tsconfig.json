{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    // No JavaScript left to compile. Kept false so a stray .js file is a
    // build error rather than something that slips through unchecked.
    "allowJs": false,

    "strict": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,

    // esbuild (Vite) and tsup do the emitting; tsc only ever type-checks.
    "noEmit": true,
    // scripts/ runs under Node's native type stripping, which needs the
    // real ".ts" extension on relative imports.
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["vite/client", "node"]
  },
  // Stories stay in the type-check: a story that no longer compiles is a
  // component that changed shape.
  "include": ["src", "electron", "scripts", ".storybook", "tsup.config.ts", "vite.config.ts"]
}
