{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    // The migration is incremental: .jsx files still compile and ship, they
    // are just not type-checked. Flipping allowJs to false is the completion
    // signal for the TypeScript work.
    "allowJs": true,
    "checkJs": false,

    "strict": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,

    // esbuild (Vite) and tsup do the emitting; tsc only ever type-checks.
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["vite/client", "node"]
  },
  // Stories stay in the type-check: a story that no longer compiles is a
  // component that changed shape.
  "include": ["src", "electron", ".storybook", "tsup.config.ts"]
}
